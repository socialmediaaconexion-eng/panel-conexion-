# Copiar a .env.local (y a las variables de entorno de Vercel) con los datos reales.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://ofudrbrtkywckshmiaci.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable key (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=            # secret key (sb_secret_...)

# Recordatorios: el cron de Supabase llama a /api/cron/recordatorios con este secreto
CRON_SECRET=

# Correo (Resend, cuenta propia de Conexión con conexionteam.app verificado). Vacío = no se envían correos.
RESEND_API_KEY=
EMAIL_REMITENTE=Conexión <citas@conexionteam.app>

# WhatsApp Business (Meta Cloud API). Vacío = no se envían WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# n8n: cotizaciones (URL de producción del webhook) y secreto compartido (encabezado X-Conexion-Secret)
N8N_COTIZACIONES_WEBHOOK=
N8N_SECRET=

# Bold: llave de identidad del Botón de pagos (panel Bold → Integraciones → Llaves de integración)
BOLD_API_KEY=
